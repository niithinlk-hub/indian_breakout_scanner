+@pytest.mark.parametrize("plan", ["t1", "t2", "t3", "t2_trail", "t3_trail"])
+def test_a_t1_only_signal_sells_everything_at_t1_whatever_the_plan(plan):
+    """MedhaSuryan on a Nifty downtrend day sends T1 only: every exit plan then sells everything at T1, and says so."""
+    intake, manager, store, quotes, sink, pos = bought(replace(LIVE, scanner_exit_plan=plan), model="medhasuryan",
+                                                       targets=[162.8])
+    if plan != "t1":
+        assert any("sell all at T1: the scanner sent targets up to T1 only" in t for t in sink.texts())
+    quotes.set(m_nov_fut="162.90", m_nov_ce="6.10")
+    run(manager.tick(T + timedelta(seconds=10)))
+    assert store.position(pos.id).state in (EXITING, CLOSED)
+    assert any("EXIT ORDER - L1 162.8 reached (last level)" in t and "x 6150" in t for t in sink.texts())
+
+

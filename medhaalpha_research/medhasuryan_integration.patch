+def test_nifty_trend_read_retries_checks_the_last_session_and_never_raises():
+    """engine._nifty_regime: tried REGIME_TRIES times, a stale last close counts as a failed read, an odd frame is
+    caught; _retry_regime fills an unknown trend in before the scan window only."""
+    import asyncio
+    from types import SimpleNamespace
+    from scanner.equity.engine import REGIME_TRIES, EquityEngine
+    from scanner.equity.features import DayContext
+    day = date(2026, 11, 16)
+    idx = pd.bdate_range(end="2026-11-13", periods=70, tz=IST)
+    falling = pd.DataFrame({"open": 1.0, "high": 1.0, "low": 1.0, "close": np.linspace(26000, 24000, 70), "volume": 0}, index=idx)
+
+    class Src:
+        vendor = "angel"
+
+        def __init__(self, answers):
+            self.answers, self.calls = list(answers), 0
+
+        async def candles(self, key, unit, interval, to, frm):
+            self.calls += 1
+            a = self.answers.pop(0) if self.answers else falling
+            if isinstance(a, Exception):
+                raise a
+            return a
+
+    def engine(answers):
+        eng = EquityEngine(source=Src(answers), cfg=EqConfig(regime_retry_s=0.0), persist=False)
+        eng.uni = SimpleNamespace(get=lambda s: SimpleNamespace(kind="INDEX", cash_key="NSE|99926000"))
+        return eng
+
+    sessions = [d.date() for d in idx]
+    eng = engine([falling.iloc[:0], RuntimeError("engine away")])        # two failed reads, then a good one
+    assert asyncio.run(eng._nifty_regime(day, sessions)) == "Downtrend" and eng.src.calls == 3 == REGIME_TRIES
+    eng = engine([falling.iloc[:-1]] * REGIME_TRIES)                     # 13 Nov missing: one session late
+    assert asyncio.run(eng._nifty_regime(day, sessions)) is None
+    assert any("older than the previous session 2026-11-13" in e for e in eng.status["errors"])
+    eng = engine([falling.drop(columns="close")] * REGIME_TRIES)         # odd frame: caught, not raised
+    assert asyncio.run(eng._nifty_regime(day, sessions)) is None and "unknown for now" in eng.status["errors"][-1]
+    muhurat = pd.concat([falling, falling.iloc[-1:].set_axis(pd.DatetimeIndex([pd.Timestamp("2026-11-15", tz=IST)]))])
+    assert asyncio.run(engine([muhurat])._nifty_regime(day, sessions)) == "Downtrend"   # a special session after it is fine
+    # an unknown trend is read again before the scan window, and handed to every stock's context
+    eng = engine([])
+    eng.day, eng.sessions, eng.nifty_regime = day, sessions, None
+    eng.ctx = {"AAA": DayContext("AAA", day, None, None, None, None, None, None, None)}
+    asyncio.run(eng._retry_regime(datetime(2026, 11, 16, 9, 30, tzinfo=IST)))       # window open: left alone
+    assert eng.nifty_regime is None and eng.src.calls == 0
+    asyncio.run(eng._retry_regime(datetime(2026, 11, 16, 9, 0, tzinfo=IST)))
+    assert eng.nifty_regime == "Downtrend" == eng.ctx["AAA"].nifty_regime == eng.status["nifty_regime"]


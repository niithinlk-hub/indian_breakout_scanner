+def test_stored_day_gains_medhasuryan_from_its_stored_scores():
+    """A stored day without medhasuryan: fable_op's stored score, or opus_v3's when the snapshot says Nifty was in a
+    downtrend; a day stored without the trend counts as no downtrend."""
+    from scanner.equity.backtest import with_all_models
+    rep = json.loads((REPORT_FILE.parent / "backtest.json").read_text(encoding="utf-8"))
+    day = rep["days"][0]
+    assert "medhasuryan" not in day["models"]
+    up = with_all_models(day, CFG)
+    assert [s["scores"]["medhasuryan"] for s in up["signals"]] == [s["scores"]["fable_op"] for s in up["signals"]]
+    assert [s["in"]["medhasuryan"] for s in up["signals"]] == [s["in"]["fable_op"] for s in up["signals"]]
+    down = dict(day, signals=[dict(s, snapshot=dict(s.get("snapshot") or {}, nifty_regime="Downtrend")) for s in day["signals"]])
+    upd = with_all_models(down, CFG)
+    assert [s["scores"]["medhasuryan"] for s in upd["signals"]] == [s["scores"]["opus_v3"] for s in upd["signals"]]
+    assert upd["models"]["medhasuryan"]["selections"]["live"]["futures"] == upd["models"]["opus_v3"]["selections"]["live"]["futures"]


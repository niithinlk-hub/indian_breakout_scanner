+REGIMES = ("Uptrend", "Downtrend", "Sideways")
+REGIME_SESSIONS = (20, 50)      # the two daily averages of Nifty's close
+
+
+def nifty_regime(nifty_daily: pd.DataFrame | None, day: date) -> str | None:
+    """Nifty's trend before the open of `day`, from its daily closes strictly before `day` (known before the open):
+    "Uptrend" when the last close is above its 20-day average and that average is above the 50-day one,
+    "Downtrend" when the last close is below its 20-day average and that average is below the 50-day one,
+    otherwise "Sideways". The averages include the last close. None with fewer than 50 closes."""
+    if nifty_daily is None or nifty_daily.empty or "close" not in nifty_daily:
+        return None
+    c = nifty_daily["close"][nifty_daily.index.date < day].astype(float).dropna()
+    short, long_ = REGIME_SESSIONS
+    if len(c) < long_:
+        return None
+    prev, ma20, ma50 = float(c.iloc[-1]), float(c.iloc[-short:].mean()), float(c.iloc[-long_:].mean())
+    if prev > ma20 > ma50:
+        return "Uptrend"
+    if prev < ma20 < ma50:
+        return "Downtrend"
+    return "Sideways"
+
+

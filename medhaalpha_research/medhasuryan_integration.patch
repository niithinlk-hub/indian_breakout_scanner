+def test_nifty_regime_from_daily_closes_before_the_day():
+    """features.nifty_regime: the last close before the day against its 20- and 50-day averages (both include it)."""
+    from scanner.equity.features import nifty_regime
+    days = pd.bdate_range("2026-06-01", periods=60, tz=IST)
+    rising = pd.DataFrame({"close": np.linspace(100, 160, 60)}, index=days)
+    assert nifty_regime(rising, days[-1].date()) == "Uptrend"              # 59 closes before the last day
+    assert nifty_regime(rising.iloc[::-1].set_axis(days), days[-1].date()) == "Downtrend"
+    assert nifty_regime(rising, days[50].date()) == "Uptrend" and nifty_regime(rising, days[49].date()) is None
+    flat_dip = pd.DataFrame({"close": [100.0] * 55 + [101.0, 102.0, 103.0, 99.0, 98.0]}, index=days)
+    assert nifty_regime(flat_dip, days[-1].date()) == "Sideways"           # below the 20-day average, which is above the 50-day
+    later = rising.copy(); later.iloc[-1] = 1.0                            # the day's own close is never read
+    assert nifty_regime(later, days[-1].date()) == "Uptrend"
+    assert nifty_regime(None, days[-1].date()) is None and nifty_regime(rising.iloc[:0], days[-1].date()) is None

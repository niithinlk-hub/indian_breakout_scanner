+def opus_v2_score(snap: dict, side: str, stop_at: str, cfg: EqConfig) -> tuple[float, dict]:
+    """Side split: a long is scored by fable_op, a short by opus. The parts are that model's own parts."""
+    return fable_op_score(snap, side, cfg) if side == LONG else opus_score(snap, side, stop_at, cfg)
+
+
+def volume_gate(score: float, parts: dict, rel_vol, side: str, cfg: EqConfig) -> tuple[float, dict]:
+    """opus_v3's gate on an opus_v2 score: a long with rel_vol under opus_v3_min_rel_vol scores 0, and a
+    'volume_gate' part shows the points taken away. A missing rel_vol passes (no volume history is not a fail)."""
+    rv = _num(rel_vol)
+    if side == LONG and rv is not None and rv < cfg.opus_v3_min_rel_vol:
+        return 0.0, dict(parts, volume_gate=-score)
+    return score, parts
+
+
+def opus_v3_score(snap: dict, side: str, stop_at: str, cfg: EqConfig) -> tuple[float, dict]:
+    """opus_v2 plus the volume gate on longs (reads rel_vol from the snapshot)."""
+    score, parts = opus_v2_score(snap, side, stop_at, cfg)
+    return volume_gate(score, parts, snap.get("rel_vol"), side, cfg)
+
